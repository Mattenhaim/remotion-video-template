{
  "name": "remotion-video-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Config-driven Remotion video template: music + on-screen text, no narration. Chassis: Vincentwei1021/video-shotcraft (Apache-2.0).",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts MainVideo out/video.mp4 --concurrency=1",
    "render:fast": "remotion render src/index.ts MainVideo out/video.mp4 --concurrency=4",
    "still": "remotion still src/index.ts MainVideo out/still.png",
    "beats": "python scripts/analyze_beats.py",
    "check": "node scripts/check-config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.484",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.484"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "6.0.3"
  }
}
